//@version=6
// =============================================================================
//  Smart-Money-Style Intraday Strategy — LAYER 1: Regime-Filter
//  -------------------------------------------------------------------------
//  Geplante Architektur (aus Briefing, wird Layer für Layer aufgebaut):
//   1) Regime      : Vola-Perzentil (ATR) + Trend/Range-State       <- DIESES LAYER
//   2) MTF-Bias    : 4H-Struktur-Bias, 1H-Zone (request.security)   <- offen
//   3) Entry       : Liquidity Sweep, BOS/CHoCH, FVG-Retest         <- offen
//   4) Konfirmation: Volumen-Proxy, RSI-Non-Divergence              <- offen
//   5) Krypto-Filter: Funding/OI (extern, optional), BTC-Beta       <- offen
//   6) Exit        : Struktur-Stop, ATR-Trail, Time-Stop, Teilexit  <- offen
//
//  WARUM NUR LAYER 1: Wir haben zwei einfachere Strategien
//  (BreakoutVolume.pine, ShortPullback.pine) noch NICHT auf mehreren Coins
//  getestet. Bevor wir 15-20 Parameter über 6 Layer aufbauen (reales
//  Overfitting-Risiko trotz "wenig Parameter pro Layer"), soll dieses
//  Skript als eigenständiger, testbarer Baustein stehen. Layer 2+ folgen,
//  sobald die Validierung der einfacheren Ansätze vorliegt.
//
//  Swing-Erkennung (für spätere BOS/CHoCH-Layer bereits vorbereitet):
//  bestätigte Pivots (ta.pivothigh/-low), kein Repaint, konsistent zu
//  RegimeAdaptiveIntraday.pine. Lag = pivLen Bars bis ein Swing "zählt".
//
//  Noch KEINE Entries/Exits in diesem Layer -> Strategy Tester zeigt 0
//  Trades, das ist erwartet. Zweck: Regime-Zustand visuell/per Tabelle
//  verifizieren, bevor Entry-Logik draufgesetzt wird.
// =============================================================================

strategy("Smart-Money Intraday — Layer 1 (Regime)",
     overlay                 = true,
     initial_capital         = 10000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.percent,
     commission_value        = input.float(0.05, "Commission %", minval = 0.0, step = 0.01, group = "0 | Kosten"),
     slippage                = input.int(1, "Slippage (Ticks)", minval = 0, group = "0 | Kosten"),
     pyramiding               = 0,
     process_orders_on_close = true,
     calc_on_every_tick      = false)

// ---------------------------------------------------------------------------
//  INPUTS — Layer 1
// ---------------------------------------------------------------------------
gVol   = "1 | Vola-Regime (ATR-Perzentil)"
atrLen     = input.int(14, "ATR Länge", minval = 2, group = gVol)
pctLookback = input.int(100, "Perzentil-Lookback", minval = 20, group = gVol)
lowTh      = input.float(25, "LOW-Schwelle (Perzentil <)", minval = 0, maxval = 100, group = gVol)
highTh     = input.float(75, "HIGH-Schwelle (Perzentil >)", minval = 0, maxval = 100, group = gVol)

gTrend = "2 | Trend/Range-State"
adxLen    = input.int(14, "ADX / DMI Länge", minval = 2, group = gTrend)
adxThresh = input.float(20.0, "ADX-Schwelle (Trend ab)", minval = 5, group = gTrend)

gStruct = "3 | Struktur-Bestätigung (optional)"
useStructConfirm = input.bool(false, "Trend nur mit HH/HL bzw. LH/LL bestätigen", group = gStruct)
pivLen = input.int(5, "Pivot-Lookback (Swing-Bestätigung)", minval = 2, group = gStruct)

gVis   = "4 | Anzeige"
showTable = input.bool(true, "Status-Tabelle anzeigen", group = gVis)

// ---------------------------------------------------------------------------
//  VOLA-REGIME — ATR-Perzentil relativ zum eigenen historischen Bereich
// ---------------------------------------------------------------------------
atr = ta.atr(atrLen)
atrPct = ta.percentrank(atr, pctLookback)   // 0-100, Position von 'atr' im Lookback

volRegime = atrPct < lowTh ? "LOW" : atrPct > highTh ? "HIGH" : "NORMAL"

// ---------------------------------------------------------------------------
//  ADX-BASIERTER TREND/RANGE-STATE
// ---------------------------------------------------------------------------
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
adxTrendUp   = adx >= adxThresh and diPlus > diMinus
adxTrendDown = adx >= adxThresh and diPlus < diMinus

// ---------------------------------------------------------------------------
//  STRUKTUR-BESTÄTIGUNG — bestätigte Pivots, HH/HL vs LH/LL-Sequenz
//  (Baustein für spätere Sweep/BOS/CHoCH-Erkennung in Layer 3)
// ---------------------------------------------------------------------------
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)

var float ph1 = na, var float ph2 = na   // ph1 = letzter, ph2 = vorletzter Pivot-High
var float pl1 = na, var float pl2 = na

if not na(ph)
    ph2 := ph1
    ph1 := ph
if not na(pl)
    pl2 := pl1
    pl1 := pl

structUp   = not na(ph2) and not na(pl2) and ph1 > ph2 and pl1 > pl2   // HH + HL
structDown = not na(ph2) and not na(pl2) and ph1 < ph2 and pl1 < pl2   // LH + LL

// ---------------------------------------------------------------------------
//  KOMBINIERTER REGIME-STATE
// ---------------------------------------------------------------------------
trendUp   = adxTrendUp   and (not useStructConfirm or structUp)
trendDown = adxTrendDown and (not useStructConfirm or structDown)

regime = trendUp ? "TREND_UP" : trendDown ? "TREND_DOWN" : "RANGE"

// ---------------------------------------------------------------------------
//  VISUALS
// ---------------------------------------------------------------------------
bgColor = regime == "TREND_UP" ? color.new(color.teal, 90)
     : regime == "TREND_DOWN" ? color.new(color.red, 90)
     : color.new(color.gray, 94)
bgcolor(bgColor, title = "Regime-State")

if showTable
    var table t = table.new(position.top_right, 2, 4, border_width = 1)
    if barstate.islast
        table.cell(t, 0, 0, "Regime", text_color = color.white, bgcolor = color.gray)
        table.cell(t, 1, 0, regime,   text_color = color.white, bgcolor = color.gray)
        table.cell(t, 0, 1, "Vola",   text_color = color.black)
        table.cell(t, 1, 1, volRegime + " (" + str.tostring(math.round(atrPct)) + ")", text_color = color.black)
        table.cell(t, 0, 2, "ADX",    text_color = color.black)
        table.cell(t, 1, 2, str.tostring(math.round(adx, 1)), text_color = color.black)
        table.cell(t, 0, 3, "Struktur", text_color = color.black)
        table.cell(t, 1, 3, structUp ? "HH/HL" : structDown ? "LH/LL" : "—", text_color = color.black)
