//@version=6
// Slot 2: MACD im unteren Pane — reine Anzeige, ohne Signale.
//
// Bewusst ein eigenes Script statt eines Moduls im Overlay: MACD rechnet in Preis-Einheiten
// (bei BTC ±hunderte, bei Cent-Coins ±0.0x), RSI und ADX in 0–100. In einem Pane mit einer
// gemeinsamen Achse wuerde eines der beiden zur platten Linie am Rand.
//
// Das Script nutzt drei Traeger, die ohne eigene Achse auskommen und deshalb beliebig viel
// Information aufnehmen, ohne das Skalenproblem zu vergroessern:
//   - table      : MACD-Zustand ueber drei Zeitrahmen als Text
//   - bgcolor    : ADX als Hintergrundtoenung des Panes
//   - force_overlay : Preislevel direkt in den Kurschart, obwohl dies ein Pane-Script ist
indicator("Confluence Simple — MACD (nur Anzeige)", overlay=false, max_labels_count=20)

// ============================================================
// INPUTS
// ============================================================

// --- MACD / PPO ---
grpMacd = "MACD"
i_source  = input.source(close, "Source", group=grpMacd)
i_fastLen = input.int(12, "Fast Länge", minval=1, group=grpMacd)
i_slowLen = input.int(26, "Slow Länge", minval=1, group=grpMacd)
i_sigLen  = input.int(9, "Signal Länge", minval=1, group=grpMacd)
i_usePpo  = input.bool(false, "Als PPO in Prozent rechnen", group=grpMacd, tooltip="MACD misst die Differenz zweier EMAs in Kurseinheiten - bei BTC 412, bei TRX 0.0003. Diese Zahlen sagen ohne Kontext nichts und sind zwischen Coins nicht vergleichbar.\n\nDer PPO (Percentage Price Oscillator) ist derselbe Aufbau, nur relativ: (EMA fast - EMA slow) / EMA slow x 100. Beide Coins stehen dann z.B. bei 1.8 %, und du entwickelst ein Gefuehl fuer viel und wenig.\n\nDie Form der Kurve bleibt identisch, nur die Skala aendert sich.")

i_showMacd   = input.bool(true, "Hauptlinie anzeigen", inline="macd", group="Linien")
i_macdCol    = input.color(color.new(#2962ff, 0), "", inline="macd", group="Linien")
i_showSignal = input.bool(true, "Signal-Linie anzeigen", inline="sig", group="Linien")
i_signalCol  = input.color(color.new(color.orange, 0), "", inline="sig", group="Linien")

i_showHist = input.bool(true, "Histogramm anzeigen", group="Histogramm")
i_histFour = input.bool(true, "Vierfarbig (Abstand wächst/schrumpft getrennt)", group="Histogramm", tooltip="Das Histogramm ist MACD MINUS Signallinie - es misst den Abstand der beiden Linien zueinander, nicht ihre Lage zur Nulllinie. Beide Linien koennen tief unter Null liegen und das Histogramm trotzdem gruen sein: dann liegt der MACD ueber seinem Signal.\n\nKraeftige Farbe = der Abstand waechst, blasse Farbe = er schrumpft.")
i_histUpStrong   = input.color(color.new(#26a69a, 0),  "MACD über Signal, Abstand wächst",    group="Histogramm")
i_histUpWeak     = input.color(color.new(#26a69a, 60), "MACD über Signal, Abstand schrumpft", group="Histogramm")
i_histDownStrong = input.color(color.new(#ef5350, 0),  "MACD unter Signal, Abstand wächst",   group="Histogramm")
i_histDownWeak   = input.color(color.new(#ef5350, 60), "MACD unter Signal, Abstand schrumpft", group="Histogramm")

i_showZero = input.bool(true, "Nulllinie anzeigen", inline="zero", group="Nulllinie")
i_zeroCol  = input.color(color.new(color.gray, 40), "", inline="zero", group="Nulllinie")

// --- ADX als Hintergrundtönung ---
// Der ADX steht im Overlay nur als Zahl in der Tabelle. Als Toenung dieses Panes beantwortet
// er beim MACD-Blick sofort die Frage, ob das Momentum in einem Trend oder im Rauschen passiert.
grpBg = "ADX-Hintergrund"
i_bgOn     = input.bool(true, "Hintergrund nach ADX tönen", group=grpBg)
i_bgAdxLen = input.int(14, "DI Länge", minval=1, group=grpBg)
i_bgAdxSm  = input.int(14, "ADX Glättung", minval=1, group=grpBg)
i_bgFrom   = input.float(20, "Tönung beginnt ab ADX", minval=0, maxval=100, group=grpBg, tooltip="Darunter bleibt der Hintergrund neutral. Ab hier wird die Toenung mit steigendem ADX kraeftiger.")
i_bgFull   = input.float(45, "Volle Tönung ab ADX", minval=0, maxval=100, group=grpBg)
i_bgCol    = input.color(color.new(#e91e63, 0), "Farbe", group=grpBg)
i_bgTransp = input.int(88, "Transparenz bei voller Tönung", minval=0, maxval=99, group=grpBg, tooltip="Unterhalb der Startschwelle ist der Hintergrund voll transparent (unsichtbar). Bei voller Toenung gilt dieser Wert: 88 bleibt dezent, kleinere Werte faerben kraeftiger.")

// --- Preislevel im Kurschart (force_overlay) ---
// Pine v6 erlaubt es, einzelne Plots eines Pane-Scripts auf den Hauptchart zu schieben.
// Damit liefert Slot 2 zusaetzlich die Preislevel, fuer die im Overlay kein Platz mehr ist.
grpLvl = "Preislevel im Kurschart"
i_lvlOn      = input.bool(true, "Level im Kurschart anzeigen", group=grpLvl, tooltip="Diese Linien erscheinen im KURSCHART, nicht in diesem Pane - moeglich per force_overlay. So belegt Slot 2 zwei Bereiche gleichzeitig.")
i_lvlWeek    = input.bool(true, "Vorwoche Hoch/Tief", inline="lw", group=grpLvl)
i_lvlWeekCol = input.color(color.new(#42a5f5, 20), "", inline="lw", group=grpLvl)
i_lvlMonth   = input.bool(true, "Vormonat Hoch/Tief", inline="lm", group=grpLvl)
i_lvlMonthCol= input.color(color.new(#ab47bc, 20), "", inline="lm", group=grpLvl)
i_lvlYear    = input.bool(true, "Jahres-Open", inline="ly", group=grpLvl)
i_lvlYearCol = input.color(color.new(#ffa726, 20), "", inline="ly", group=grpLvl)
i_lvlMode    = input.string("Nur Zahl am rechten Rand", "Darstellung", options=["Nur Zahl am rechten Rand", "Linie + Zahl", "Nur Linie"], group=grpLvl, tooltip="Der Chart traegt bereits MAs, Ichimoku, zwei Bollinger-Baender und den VWAP. Fuenf weitere Linien machen ihn schnell unlesbar - die Zahl am rechten Rand steht auf der richtigen Kurshoehe und liefert dieselbe Information ohne einen einzigen zusaetzlichen Strich.")
i_lvlOffset  = input.int(3, "Abstand der Beschriftung (Kerzen)", minval=0, group=grpLvl)

// --- Tabelle im Pane ---
grpTbl = "Tabelle"
i_tblOn   = input.bool(true, "Tabelle anzeigen", group=grpTbl)
i_tblPos  = input.string("Oben rechts", "Position", options=["Oben rechts", "Oben links", "Unten rechts", "Unten links", "Mitte rechts", "Mitte links"], group=grpTbl)
i_tblSize = input.string("Klein", "Schriftgröße", options=["Klein", "Normal", "Groß"], group=grpTbl)
i_tblBg   = input.color(color.new(color.black, 70), "Hintergrund", group=grpTbl)
i_tblHead = input.color(color.new(color.gray, 20), "Farbe Beschriftungen", group=grpTbl)

i_tfS1 = input.bool(true, "Zeitrahmen 1", inline="tf1", group=grpTbl, tooltip="Eine Zeile ist nur verlaesslich, wenn ihr Zeitrahmen GLEICH ODER GROESSER ist als der Chart-Zeitrahmen.\n\nAuf dem Tages-Chart stimmen D, W und M. Auf dem Wochen-Chart schwankt die D-Zeile, auf dem Monats-Chart D und W - ein groesserer Chart kennt die einzelnen Tage nicht genau, solange seine eigene Kerze noch laeuft.\n\nDie Tabelle deshalb am besten auf dem kleinsten der drei Zeitrahmen ablesen. Das ist kein Fehler, sondern eine Eigenschaft der Zeitrahmen-Abfrage.")
i_tf1  = input.timeframe("D", "", inline="tf1", group=grpTbl)
i_tfS2 = input.bool(true, "Zeitrahmen 2", inline="tf2", group=grpTbl)
i_tf2  = input.timeframe("W", "", inline="tf2", group=grpTbl)
i_tfS3 = input.bool(true, "Zeitrahmen 3", inline="tf3", group=grpTbl)
i_tf3  = input.timeframe("M", "", inline="tf3", group=grpTbl)

i_htfLive = input.bool(true, "Laufende Kerze der Zeitrahmen verwenden", group=grpTbl, tooltip="An: alle Zeitrahmen zeigen ihren aktuellen Stand, also vergleichbare Momentaufnahmen.\n\nAus: nur abgeschlossene Kerzen. Stabil, aber die Monatszeile hinkt dann bis zu einem Monat hinterher.")
i_upCol   = input.color(color.new(#26a69a, 0), "Farbe positiv", inline="tcol", group=grpTbl)
i_downCol = input.color(color.new(#ef5350, 0), "Farbe negativ", inline="tcol", group=grpTbl)

// ============================================================
// BERECHNUNGEN
// ============================================================

// MACD und PPO werden beide auf jeder Kerze gerechnet und erst danach ausgewaehlt. Im
// Ternaer-Operator wuerde nur der genommene Zweig laufen - ta.ema fuehrt internen Zustand mit
// und liefert nach einem Umschalten falsche Werte, bis es sich wieder eingeschwungen hat.
f_osc(float src, simple int fastLen, simple int slowLen, simple int sigLen, simple bool asPpo) =>
    emaFast = ta.ema(src, fastLen)
    emaSlow = ta.ema(src, slowLen)
    macdRaw = emaFast - emaSlow
    ppoRaw  = emaSlow == 0 ? 0.0 : (emaFast - emaSlow) / emaSlow * 100
    mainRaw = asPpo ? ppoRaw : macdRaw
    // Die Signal-EMA muss auf der GEWAEHLTEN Reihe laufen, sonst passen Linie und Signal nicht
    // zusammen. Deshalb hier je eine Signallinie fuer beide Varianten, Auswahl danach.
    sigMacd = ta.ema(macdRaw, sigLen)
    sigPpo  = ta.ema(ppoRaw, sigLen)
    sigOut  = asPpo ? sigPpo : sigMacd
    [mainRaw, sigOut, mainRaw - sigOut]

[macdLine, signalLine, histLine] = f_osc(i_source, i_fastLen, i_slowLen, i_sigLen, i_usePpo)

histRising = histLine > histLine[1]
histCol = not i_histFour ? (histLine >= 0 ? i_histUpStrong : i_histDownStrong) : histLine >= 0 ? (histRising ? i_histUpStrong : i_histUpWeak) : (histRising ? i_histDownWeak : i_histDownStrong)

// --- ADX für die Hintergrundtönung ---
[bgDiPlus, bgDiMinus, bgAdx] = ta.dmi(i_bgAdxLen, i_bgAdxSm)

// Lineare Abbildung: unterhalb der Startschwelle keine Toenung, ab "volle Toenung" konstant.
bgSpan  = math.max(1.0, i_bgFull - i_bgFrom)
bgRatio = math.max(0.0, math.min(1.0, (bgAdx - i_bgFrom) / bgSpan))
bgTransp = na(bgAdx) or bgRatio <= 0 ? 100 : int(100 - bgRatio * (100 - i_bgTransp))

// --- MACD-Zustand über drei Zeitrahmen ---
// Als Linien ginge das nicht: ein Wochen-MACD misst Kursdifferenzen ueber Wochen und ist damit
// um ein Vielfaches groesser als der Tageswert - er wuerde die Achse an sich reissen. Als Text
// bleibt dieselbe Information erhalten, ohne dass eine Skala daran haengt.
htfOff = i_htfLive ? 0 : 1
// Hist: MACD ueber/unter der SIGNALLINIE. Null: MACD ueber/unter der NULLLINIE.
// Rtg: waechst oder schrumpft das HISTOGRAMM - also der Abstand der beiden Linien. Das ist
// NICHT die Richtung der MACD-Linie: die kann steigen, waehrend das Histogramm schrumpft,
// naemlich wenn die Signallinie schneller steigt. Genau das ist der Frühwarnfall.
macdState = macdLine >= 0 ? 1.0 : -1.0
histState = histLine >= 0 ? 1.0 : -1.0
dirState  = histRising ? 1.0 : -1.0

// lookahead_on ist hier korrekt, obwohl es sonst die Warnlampe ist: Mit lookahead_off liefert
// eine HISTORISCHE Kerze die letzte ABGESCHLOSSENE Wochenkerze, waehrend der W-Chart die
// laufende zeigt. Bei geschlossener Boerse ist die letzte Tageskerze historisch, also standen
// D-Chart und W-Chart um genau eine Woche versetzt (bei ASTS aufgefallen).
// Unbedenklich, weil diese drei Reihen AUSSCHLIESSLICH in der Tabelle unter barstate.islast
// landen und nie geplottet werden - historische Werte bekommt niemand zu sehen. Wer sie je
// plotten will, braucht wieder lookahead_off.
[mTf1, hTf1, dTf1] = request.security(syminfo.tickerid, i_tf1, [macdState[htfOff], histState[htfOff], dirState[htfOff]], lookahead=barmerge.lookahead_on)
[mTf2, hTf2, dTf2] = request.security(syminfo.tickerid, i_tf2, [macdState[htfOff], histState[htfOff], dirState[htfOff]], lookahead=barmerge.lookahead_on)
[mTf3, hTf3, dTf3] = request.security(syminfo.tickerid, i_tf3, [macdState[htfOff], histState[htfOff], dirState[htfOff]], lookahead=barmerge.lookahead_on)

// --- Preislevel ---
// high[1] bzw. low[1] mit lookahead_on ist das uebliche repaint-freie Muster fuer den Wert der
// ABGESCHLOSSENEN Vorperiode: der steht bereits fest, es wird also nichts vorweggenommen.
prevWeekHigh  = request.security(syminfo.tickerid, "W",   high[1], lookahead=barmerge.lookahead_on)
prevWeekLow   = request.security(syminfo.tickerid, "W",   low[1],  lookahead=barmerge.lookahead_on)
prevMonthHigh = request.security(syminfo.tickerid, "M",   high[1], lookahead=barmerge.lookahead_on)
prevMonthLow  = request.security(syminfo.tickerid, "M",   low[1],  lookahead=barmerge.lookahead_on)
// Der Eroeffnungskurs der LAUFENDEN Jahreskerze steht seit deren erster Sekunde fest.
yearOpen      = request.security(syminfo.tickerid, "12M", open,    lookahead=barmerge.lookahead_on)

lvlShowLine  = i_lvlMode != "Nur Zahl am rechten Rand"
lvlShowLabel = i_lvlMode != "Nur Linie"

// ============================================================
// PLOTS (dieses Pane)
// ============================================================

plot(i_showHist ? histLine : na, title="Histogramm", style=plot.style_columns, color=histCol)
plot(i_showMacd ? macdLine : na, title="MACD / PPO", color=i_macdCol, linewidth=2)
plot(i_showSignal ? signalLine : na, title="Signal", color=i_signalCol, linewidth=2)
plot(i_showZero ? 0.0 : na, title="Nulllinie", color=i_zeroCol, linewidth=1)

bgcolor(i_bgOn ? color.new(i_bgCol, bgTransp) : na, title="ADX Trendstärke")

// ============================================================
// PREISLEVEL IM KURSCHART (force_overlay)
// ============================================================

plot(i_lvlOn and lvlShowLine and i_lvlWeek  ? prevWeekHigh  : na, title="Vorwoche Hoch",  color=i_lvlWeekCol,  linewidth=1, style=plot.style_linebr, force_overlay=true)
plot(i_lvlOn and lvlShowLine and i_lvlWeek  ? prevWeekLow   : na, title="Vorwoche Tief",  color=i_lvlWeekCol,  linewidth=1, style=plot.style_linebr, force_overlay=true)
plot(i_lvlOn and lvlShowLine and i_lvlMonth ? prevMonthHigh : na, title="Vormonat Hoch",  color=i_lvlMonthCol, linewidth=1, style=plot.style_linebr, force_overlay=true)
plot(i_lvlOn and lvlShowLine and i_lvlMonth ? prevMonthLow  : na, title="Vormonat Tief",  color=i_lvlMonthCol, linewidth=1, style=plot.style_linebr, force_overlay=true)
plot(i_lvlOn and lvlShowLine and i_lvlYear  ? yearOpen      : na, title="Jahres-Open",    color=i_lvlYearCol,  linewidth=1, style=plot.style_linebr, force_overlay=true)

// Beschriftung am rechten Rand, auf Hoehe des jeweiligen Kurses. Der Kurs steht mit im Text,
// damit die Angabe auch ohne Linie fuer sich steht.
f_lvlLabel(bool show, float price, string txt, color col) =>
    var label lb = na
    label.delete(lb)
    if show and not na(price)
        lb := label.new(bar_index + i_lvlOffset, price, txt + "  " + str.tostring(price, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=col, size=size.small, force_overlay=true)
    lb

if barstate.islast
    f_lvlLabel(i_lvlOn and lvlShowLabel and i_lvlWeek,  prevWeekHigh,  "Vorwoche H",  i_lvlWeekCol)
    f_lvlLabel(i_lvlOn and lvlShowLabel and i_lvlWeek,  prevWeekLow,   "Vorwoche T",  i_lvlWeekCol)
    f_lvlLabel(i_lvlOn and lvlShowLabel and i_lvlMonth, prevMonthHigh, "Vormonat H",  i_lvlMonthCol)
    f_lvlLabel(i_lvlOn and lvlShowLabel and i_lvlMonth, prevMonthLow,  "Vormonat T",  i_lvlMonthCol)
    f_lvlLabel(i_lvlOn and lvlShowLabel and i_lvlYear,  yearOpen,      "Jahres-Open", i_lvlYearCol)

// ============================================================
// TABELLE
// ============================================================

f_tblPos() =>
    switch i_tblPos
        "Oben links"   => position.top_left
        "Unten rechts" => position.bottom_right
        "Unten links"  => position.bottom_left
        "Mitte rechts" => position.middle_right
        "Mitte links"  => position.middle_left
        =>                position.top_right

f_tblSize() =>
    switch i_tblSize
        "Normal" => size.normal
        "Groß"   => size.large
        =>          size.small

f_signTxt(float v) =>
    na(v) ? "—" : v > 0 ? "+" : "−"

f_dirTxt(float v) =>
    na(v) ? "—" : v > 0 ? "↑" : "↓"

f_colOf(float v) =>
    na(v) ? i_tblHead : v > 0 ? i_upCol : i_downCol

// 4 Spalten (Zeitrahmen + Linie + Histogramm + Richtung), 4 Zeilen (Kopf + 3 Zeitrahmen).
var table tbl = table.new(f_tblPos(), 4, 4, bgcolor=i_tblBg, frame_width=0, border_width=0)

if i_tblOn and barstate.islast
    table.clear(tbl, 0, 0, 3, 3)
    int r = 0

    // Reihenfolge als Steigerungsleiter, in der die Bedingungen typischerweise eintreten:
    // erst kreuzt der MACD sein Signal (Hist), dann schiebt er sich ueber Null (Null),
    // dann waechst der Abstand (Rtg).
    table.cell(tbl, 0, r, i_usePpo ? "PPO" : "MACD", text_color=i_tblHead, text_size=size.small)
    table.cell(tbl, 1, r, "Hist", text_color=i_tblHead, text_size=size.small)
    table.cell(tbl, 2, r, "Null", text_color=i_tblHead, text_size=size.small)
    table.cell(tbl, 3, r, "Rtg", text_color=i_tblHead, text_size=size.small)
    r += 1

    tfLabels = array.from(i_tf1, i_tf2, i_tf3)
    tfShow   = array.from(i_tfS1, i_tfS2, i_tfS3)
    tfMacd   = array.from(mTf1, mTf2, mTf3)
    tfHist   = array.from(hTf1, hTf2, hTf3)
    tfDir    = array.from(dTf1, dTf2, dTf3)

    for i = 0 to 2
        if array.get(tfShow, i)
            vM = array.get(tfMacd, i)
            vH = array.get(tfHist, i)
            vD = array.get(tfDir, i)
            table.cell(tbl, 0, r, array.get(tfLabels, i), text_color=i_tblHead, text_size=f_tblSize())
            table.cell(tbl, 1, r, f_signTxt(vH), text_color=f_colOf(vH), text_size=f_tblSize())
            table.cell(tbl, 2, r, f_signTxt(vM), text_color=f_colOf(vM), text_size=f_tblSize())
            table.cell(tbl, 3, r, f_dirTxt(vD),  text_color=f_colOf(vD), text_size=f_tblSize())
            r += 1
