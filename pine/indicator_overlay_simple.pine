//@version=6
// Vereinfachte Version des "Confluence Buy/Sell Signal" — reine Anzeige, ohne Signale.
// Entfernt: Konfluenz-Score, BUY/SELL/EXIT, ADX-Filter, MACD, Volumen, Engulfing,
// Inside Bar, Golden/Death Cross, TK-Cross, 200MA-Cross, Score-Hintergrund, alle Alerts.
// Stufe 1 - vier Bausteine: 6x MA (SMA/EMA), Supertrend, Ichimoku, Bollinger (2.0 + 2.5)
// Stufe 2 - RSI, ohne eigenes Pane (siehe Block "RSI" unten)
indicator("Confluence Simple (nur Anzeige)", overlay=true)

// ============================================================
// INPUTS
// ============================================================

// --- Moving Averages (frei wählbar, nur Anzeige) ---
i_ma1Show = input.bool(true, "MA 1 anzeigen", inline="ma1", group="Moving Averages")
i_ma1Type = input.string("SMA", "", options=["SMA", "EMA"], inline="ma1", group="Moving Averages")
i_ma1Len  = input.int(10, "", minval=1, inline="ma1", group="Moving Averages")
i_ma1Col  = input.color(color.yellow, "", inline="ma1", group="Moving Averages")

i_ma2Show = input.bool(true, "MA 2 anzeigen", inline="ma2", group="Moving Averages")
i_ma2Type = input.string("SMA", "", options=["SMA", "EMA"], inline="ma2", group="Moving Averages")
i_ma2Len  = input.int(20, "", minval=1, inline="ma2", group="Moving Averages")
i_ma2Col  = input.color(color.green, "", inline="ma2", group="Moving Averages")

i_ma3Show = input.bool(true, "MA 3 anzeigen", inline="ma3", group="Moving Averages")
i_ma3Type = input.string("SMA", "", options=["SMA", "EMA"], inline="ma3", group="Moving Averages")
i_ma3Len  = input.int(50, "", minval=1, inline="ma3", group="Moving Averages")
i_ma3Col  = input.color(color.purple, "", inline="ma3", group="Moving Averages")

i_ma4Show = input.bool(false, "MA 4 anzeigen", inline="ma4", group="Moving Averages")
i_ma4Type = input.string("SMA", "", options=["SMA", "EMA"], inline="ma4", group="Moving Averages")
i_ma4Len  = input.int(100, "", minval=1, inline="ma4", group="Moving Averages")
i_ma4Col  = input.color(color.teal, "", inline="ma4", group="Moving Averages")

i_ma5Show = input.bool(false, "MA 5 anzeigen", inline="ma5", group="Moving Averages")
i_ma5Type = input.string("SMA", "", options=["SMA", "EMA"], inline="ma5", group="Moving Averages")
i_ma5Len  = input.int(200, "", minval=1, inline="ma5", group="Moving Averages")
i_ma5Col  = input.color(color.maroon, "", inline="ma5", group="Moving Averages")

i_ma6Show = input.bool(false, "MA 6 anzeigen", inline="ma6", group="Moving Averages")
i_ma6Type = input.string("EMA", "", options=["SMA", "EMA"], inline="ma6", group="Moving Averages")
i_ma6Len  = input.int(9, "", minval=1, inline="ma6", group="Moving Averages")
i_ma6Col  = input.color(color.orange, "", inline="ma6", group="Moving Averages")

i_maSource = input.source(close, "Source (alle MAs)", group="Moving Averages")

// --- Supertrend ---
i_showSupertrend = input.bool(true, "Supertrend anzeigen", group="Supertrend")
i_stAtrPeriod    = input.int(10, "ATR Länge", minval=1, group="Supertrend")
i_stFactor       = input.float(3.0, "Faktor", minval=0.1, step=0.1, group="Supertrend")
i_stBullCol      = input.color(color.green, "Supertrend Farbe (bullish)", group="Supertrend")
i_stBearCol      = input.color(color.red, "Supertrend Farbe (bärisch)", group="Supertrend")

// --- Ichimoku ---
i_useIchimoku   = input.bool(true, "Ichimoku Cloud verwenden", group="Ichimoku")
i_tenkanLen     = input.int(9, "Tenkan-sen", minval=1, group="Ichimoku")
i_kijunLen      = input.int(26, "Kijun-sen", minval=1, group="Ichimoku")
i_senkouBLen    = input.int(52, "Senkou Span B", minval=1, group="Ichimoku")
i_displacement  = input.int(27, "Verschiebung", minval=1, tooltip="27 mit Plot-Offset (displacement - 1), damit die Cloud deckungsgleich mit den TV-Indikatoren liegt.", group="Ichimoku")
i_showCloud     = input.bool(true, "Cloud anzeigen", group="Ichimoku")
i_showTK        = input.bool(true, "Tenkan/Kijun-Linien anzeigen", group="Ichimoku")
i_showChikou    = input.bool(true, "Lagging Span (Chikou) anzeigen", group="Ichimoku")
i_senkouACol    = input.color(color.new(color.green, 70), "Senkou Span A Farbe", group="Ichimoku")
i_senkouBCol    = input.color(color.new(color.red, 70), "Senkou Span B Farbe", group="Ichimoku")
i_cloudBullCol  = input.color(color.new(color.green, 90), "Cloud Farbe (bullish)", group="Ichimoku")
i_cloudBearCol  = input.color(color.new(color.red, 90), "Cloud Farbe (bearish)", group="Ichimoku")
i_tenkanCol     = input.color(color.new(color.blue, 40), "Tenkan-sen Farbe", group="Ichimoku")
i_kijunCol      = input.color(color.new(color.orange, 40), "Kijun-sen Farbe", group="Ichimoku")
i_chikouCol     = input.color(color.new(color.fuchsia, 40), "Lagging Span Farbe", group="Ichimoku")

// --- Bollinger Bands (2 Bänder mit gemeinsamer Länge) ---
i_showBB     = input.bool(true, "BB 1 (2.0 StdDev) anzeigen", group="Bollinger Bands")
i_bbLen      = input.int(20, "Länge (gemeinsam für beide Bänder)", minval=1, group="Bollinger Bands")
i_bbMult     = input.float(2.0, "StdDev Multiplikator BB 1", minval=0.1, step=0.1, group="Bollinger Bands")
i_bbUpperCol = input.color(color.aqua, "BB 1 Upper Farbe", group="Bollinger Bands")
i_bbLowerCol = input.color(color.aqua, "BB 1 Lower Farbe", group="Bollinger Bands")
i_bbFillCol  = input.color(color.new(color.gray, 90), "BB 1 Füllung Farbe", group="Bollinger Bands")

i_showBB2     = input.bool(true, "BB 2 (2.5 StdDev) anzeigen", group="Bollinger Bands")
i_bbMult2     = input.float(2.5, "StdDev Multiplikator BB 2", minval=0.1, step=0.1, group="Bollinger Bands")
i_bbUpperCol2 = input.color(color.navy, "BB 2 Upper Farbe", group="Bollinger Bands")
i_bbLowerCol2 = input.color(color.navy, "BB 2 Lower Farbe", group="Bollinger Bands")
i_bbFillCol2  = input.color(color.new(color.purple, 92), "BB 2 Füllung Farbe", group="Bollinger Bands")

i_showBBBasis = input.bool(true, "Basis-Linie (Mitte) anzeigen", group="Bollinger Bands")
i_bbBasisCol  = input.color(color.gray, "Basis (SMA) Farbe", group="Bollinger Bands")
i_bbFill      = input.bool(true, "Band-Füllung anzeigen (beide)", group="Bollinger Bands")

// --- RSI ---
// Der RSI läuft 0-100, dieses Script liegt auf der Preisachse. Eine normale RSI-Linie wäre
// hier der Kurs 62 statt der Wert 62 - also unsichtbar. Deshalb drei Darstellungsformen,
// die ohne eigene Achse auskommen. Alle drei einzeln abschaltbar.
grpRSI = "RSI"
i_rsiOn     = input.bool(true, "RSI aktiv", group=grpRSI)
i_rsiLen    = input.int(14, "RSI Länge", minval=1, group=grpRSI)
i_rsiSource = input.source(close, "Source", group=grpRSI)
i_rsiOB     = input.float(70, "Überkauft", minval=50, maxval=100, group=grpRSI)
i_rsiOS     = input.float(30, "Überverkauft", minval=0, maxval=50, group=grpRSI)
i_rsiObCol  = input.color(color.new(color.red, 0), "Farbe überkauft", inline="rsicol", group=grpRSI)
i_rsiOsCol  = input.color(color.new(color.green, 0), "Farbe überverkauft", inline="rsicol", group=grpRSI)

// Form 1: Zahlenfeld in der Chart-Ecke
i_rsiTable    = input.bool(true, "Zahlenfeld anzeigen", group=grpRSI)
i_rsiTablePos = input.string("Oben rechts", "Position", options=["Oben rechts", "Oben links", "Unten rechts", "Unten links", "Mitte rechts", "Mitte links"], group=grpRSI)
i_rsiTableSize= input.string("Normal", "Schriftgröße", options=["Klein", "Normal", "Groß"], group=grpRSI)
i_rsiNeutral  = input.color(color.new(color.gray, 0), "Farbe neutral (zwischen den Zonen)", group=grpRSI)
i_rsiTableBg  = input.color(color.new(color.black, 70), "Hintergrund Zahlenfeld", group=grpRSI)

// Form 2: Kerzenfärbung in den Extremzonen
i_rsiBarCol   = input.bool(false, "Kerzen in OB/OS-Zone einfärben", group=grpRSI, tooltip="Färbt nur Kerzen, deren RSI über der Überkauft- bzw. unter der Überverkauft-Schwelle liegt. Alle übrigen Kerzen behalten ihre normale Farbe.")

// Form 3: RSI-Kurve, auf ein Preisband gemappt
i_rsiCurve    = input.bool(false, "RSI-Kurve ins Chart mappen", group=grpRSI, tooltip="Zeichnet den echten RSI-Verlauf, umgerechnet auf ein Preisband aus Hoch/Tief der letzten N Kerzen. Die Höhe im Chart ist dadurch willkürlich - sie sagt nichts über das Kursniveau aus, nur die Form und die Lage zu den 70/30-Linien sind aussagekräftig.")
i_rsiCurveLb  = input.int(200, "Lookback für das Band", minval=10, group=grpRSI)
i_rsiCurveCol = input.color(color.new(#7e57c2, 0), "Kurven Farbe", group=grpRSI)
i_rsiCurveLvl = input.color(color.new(#7e57c2, 65), "Farbe der gemappten 70/30-Linien", group=grpRSI)

// ============================================================
// BERECHNUNGEN
// ============================================================

// --- Moving Averages ---
f_ma(string maType, float src, simple int len) =>
    maType == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

ma1 = f_ma(i_ma1Type, i_maSource, i_ma1Len)
ma2 = f_ma(i_ma2Type, i_maSource, i_ma2Len)
ma3 = f_ma(i_ma3Type, i_maSource, i_ma3Len)
ma4 = f_ma(i_ma4Type, i_maSource, i_ma4Len)
ma5 = f_ma(i_ma5Type, i_maSource, i_ma5Len)
ma6 = f_ma(i_ma6Type, i_maSource, i_ma6Len)

// --- Supertrend ---
[supertrendVal, supertrendDir] = ta.supertrend(i_stFactor, i_stAtrPeriod)
supertrendBullish = supertrendDir < 0

// --- Ichimoku Cloud ---
tenkan  = (ta.highest(high, i_tenkanLen) + ta.lowest(low, i_tenkanLen)) / 2
kijun   = (ta.highest(high, i_kijunLen) + ta.lowest(low, i_kijunLen)) / 2
senkouA = (tenkan + kijun) / 2
senkouB = (ta.highest(high, i_senkouBLen) + ta.lowest(low, i_senkouBLen)) / 2

// --- Bollinger Bands ---
bbBasis = ta.sma(close, i_bbLen)
bbStdev = ta.stdev(close, i_bbLen)
bbDev   = i_bbMult * bbStdev
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbDev2   = i_bbMult2 * bbStdev
bbUpper2 = bbBasis + bbDev2
bbLower2 = bbBasis - bbDev2

// --- RSI ---
rsi        = ta.rsi(i_rsiSource, i_rsiLen)
rsiOB      = i_rsiOn and rsi >= i_rsiOB
rsiOS      = i_rsiOn and rsi <= i_rsiOS
rsiZoneCol = rsiOB ? i_rsiObCol : rsiOS ? i_rsiOsCol : i_rsiNeutral

// Mapping des RSI (0-100) auf ein Preisband aus Hoch/Tief der letzten N Kerzen.
rsiBandHi = ta.highest(high, i_rsiCurveLb)
rsiBandLo = ta.lowest(low, i_rsiCurveLb)
f_rsiToPrice(float v) =>
    rsiBandLo + (v / 100.0) * (rsiBandHi - rsiBandLo)

// ============================================================
// PLOTS
// ============================================================

plot(i_ma1Show ? ma1 : na, color=i_ma1Col, title="MA 1", linewidth=2)
plot(i_ma2Show ? ma2 : na, color=i_ma2Col, title="MA 2", linewidth=2)
plot(i_ma3Show ? ma3 : na, color=i_ma3Col, title="MA 3", linewidth=2)
plot(i_ma4Show ? ma4 : na, color=i_ma4Col, title="MA 4", linewidth=2)
plot(i_ma5Show ? ma5 : na, color=i_ma5Col, title="MA 5", linewidth=2)
plot(i_ma6Show ? ma6 : na, color=i_ma6Col, title="MA 6", linewidth=2)

plot(i_showSupertrend ? supertrendVal : na, title="Supertrend", color=supertrendBullish ? i_stBullCol : i_stBearCol, linewidth=2, style=plot.style_linebr)

senkouAPlot = plot(i_useIchimoku and i_showCloud ? senkouA : na, offset=i_displacement - 1, color=i_senkouACol, title="Senkou Span A")
senkouBPlot = plot(i_useIchimoku and i_showCloud ? senkouB : na, offset=i_displacement - 1, color=i_senkouBCol, title="Senkou Span B")
fill(senkouAPlot, senkouBPlot, color = senkouA > senkouB ? i_cloudBullCol : i_cloudBearCol, title="Kumo Cloud")

plot(i_useIchimoku and i_showTK ? tenkan : na, color=i_tenkanCol, title="Tenkan-sen")
plot(i_useIchimoku and i_showTK ? kijun : na, color=i_kijunCol, title="Kijun-sen")

// Lagging Span (Chikou): Close um dieselbe Distanz nach LINKS verschoben wie die Cloud nach rechts
plot(i_useIchimoku and i_showChikou ? close : na, offset=-i_displacement + 1, color=i_chikouCol, title="Lagging Span (Chikou)")

bbUpperPlot = plot(i_showBB ? bbUpper : na, color=i_bbUpperCol, title="BB1 Upper (2.0)", linewidth=2)
bbLowerPlot = plot(i_showBB ? bbLower : na, color=i_bbLowerCol, title="BB1 Lower (2.0)", linewidth=2)
plot(i_showBBBasis ? bbBasis : na, color=i_bbBasisCol, title="BB Basis")
fill(bbUpperPlot, bbLowerPlot, color = i_showBB and i_bbFill ? i_bbFillCol : na, title="BB1 Füllung")

bbUpperPlot2 = plot(i_showBB2 ? bbUpper2 : na, color=i_bbUpperCol2, title="BB2 Upper (2.5)", linewidth=2)
bbLowerPlot2 = plot(i_showBB2 ? bbLower2 : na, color=i_bbLowerCol2, title="BB2 Lower (2.5)", linewidth=2)
fill(bbUpperPlot2, bbLowerPlot2, color = i_showBB2 and i_bbFill ? i_bbFillCol2 : na, title="BB2 Füllung")

// --- RSI, Form 3: gemappte Kurve ---
plot(i_rsiOn and i_rsiCurve ? f_rsiToPrice(rsi) : na, title="RSI (gemappt)", color=i_rsiCurveCol, linewidth=2)
plot(i_rsiOn and i_rsiCurve ? f_rsiToPrice(i_rsiOB) : na, title="RSI Überkauft (gemappt)", color=i_rsiCurveLvl, linewidth=1)
plot(i_rsiOn and i_rsiCurve ? f_rsiToPrice(i_rsiOS) : na, title="RSI Überverkauft (gemappt)", color=i_rsiCurveLvl, linewidth=1)

// --- RSI, Form 2: Kerzenfärbung ---
// na = kein Eingriff, die Kerze behält ihre normale Farbe. Betrifft nur Kerzen in der Zone.
barcolor(i_rsiOn and i_rsiBarCol ? (rsiOB ? i_rsiObCol : rsiOS ? i_rsiOsCol : na) : na, title="RSI Kerzenfärbung")

// --- RSI, Form 1: Zahlenfeld ---
f_tablePos() =>
    switch i_rsiTablePos
        "Oben links"   => position.top_left
        "Unten rechts" => position.bottom_right
        "Unten links"  => position.bottom_left
        "Mitte rechts" => position.middle_right
        "Mitte links"  => position.middle_left
        => position.top_right

f_tableSize() =>
    switch i_rsiTableSize
        "Klein" => size.small
        "Groß"  => size.large
        => size.normal

var table rsiTable = table.new(f_tablePos(), 1, 2, bgcolor=i_rsiTableBg, frame_width=0, border_width=0)

if i_rsiOn and i_rsiTable and barstate.islast
    table.cell(rsiTable, 0, 0, "RSI " + str.tostring(i_rsiLen), text_color=color.new(color.gray, 20), text_size=size.small)
    table.cell(rsiTable, 0, 1, str.tostring(rsi, "#.0"), text_color=rsiZoneCol, text_size=f_tableSize())
