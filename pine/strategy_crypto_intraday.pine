//@version=6
// Crypto Intraday Trend Strategy — SIMPLE (Backtest)
// Radikal vereinfachte Version: kein Score, kein HTF, kein Funding/OI, keine Marktstruktur.
// Nur 4 UND-verknuepfte Bedingungen + ein Exit-Verfahren (ATR-Trailing).
// Backtestbares Gegenstueck zu indicator_crypto_intraday.pine (identische Logik).
strategy("Crypto Intraday Trend Strategy [Simple]", shorttitle="CIT-Simple [Strat]",
     overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2, calc_on_every_tick=false, pyramiding=0)

// ===================== INPUTS =====================
grpTrend = "Trend"
emaFastLen = input.int(20, "EMA Fast", group=grpTrend)
emaSlowLen = input.int(50, "EMA Slow", group=grpTrend)

grpMom = "Momentum"
macdFastLen = input.int(12, "MACD Fast", group=grpMom)
macdSlowLen = input.int(26, "MACD Slow", group=grpMom)
macdSigLen  = input.int(9, "MACD Signal", group=grpMom)

grpVol = "Volume"
volEmaLen       = input.int(20, "Volume EMA Length", group=grpVol)
useVolumeFilter = input.bool(true, "Volumen-Filter aktiv", group=grpVol)

grpADX = "ADX"
adxLen = input.int(14, "ADX Length", group=grpADX)
adxMin = input.float(20, "Min ADX", group=grpADX)

grpExit = "Exit (ATR Trailing)"
atrStopMult    = input.float(2.0, "Initial Stop (x ATR)", group=grpExit)
chandelierLen  = input.int(22, "Trailing ATR Length", group=grpExit)
chandelierMult = input.float(3.0, "Trailing ATR Mult", group=grpExit)

// ===================== LOGIK =====================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
trendUp   = emaFast > emaSlow and close > emaFast
trendDown = emaFast < emaSlow and close < emaFast

[macdLine, signalLine, histLine] = ta.macd(close, macdFastLen, macdSlowLen, macdSigLen)
momUp   = histLine > 0 and histLine > histLine[1]
momDown = histLine < 0 and histLine < histLine[1]

volEma = ta.ema(volume, volEmaLen)
volOk  = not useVolumeFilter or volume > volEma

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOk = adxVal >= adxMin

longSignal  = trendUp and momUp and volOk and adxOk
shortSignal = trendDown and momDown and volOk and adxOk

// ===================== STOP (Initial ATR + Trailing) =====================
atrVal = ta.atr(chandelierLen)
chLongStop  = ta.highest(high, chandelierLen) - chandelierMult * atrVal
chShortStop = ta.lowest(low, chandelierLen) + chandelierMult * atrVal

var float longStopLevel  = na
var float shortStopLevel = na

if longSignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
    longStopLevel := close - atrStopMult * atrVal

if shortSignal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
    shortStopLevel := close + atrStopMult * atrVal

if strategy.position_size > 0
    longStopLevel := math.max(longStopLevel, chLongStop)
    strategy.exit("Long Exit", "Long", stop=longStopLevel)

if strategy.position_size < 0
    shortStopLevel := math.min(shortStopLevel, chShortStop)
    strategy.exit("Short Exit", "Short", stop=shortStopLevel)

// ===================== PLOTS =====================
plot(emaFast, "EMA Fast", color=color.new(color.blue, 0))
plot(emaSlow, "EMA Slow", color=color.new(color.orange, 0))
plotshape(longSignal, "Long Signal", shape.triangleup, location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(shortSignal, "Short Signal", shape.triangledown, location.abovebar, color=color.new(color.red, 0), size=size.small)
plot(strategy.position_size > 0 ? longStopLevel : na, "Long Stop", color=color.new(color.red, 0), style=plot.style_circles)
plot(strategy.position_size < 0 ? shortStopLevel : na, "Short Stop", color=color.new(color.red, 0), style=plot.style_circles)
